{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "python3 kb/tools/kb.py *": "allow",
      "python kb/tools/kb.py *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "grep *": "allow",
      "python3 kb/tools/kb.py commit apply*": "ask",
      "python kb/tools/kb.py commit apply*": "ask",
      "python3 kb/tools/kb.py ask send*": "ask",
      "python kb/tools/kb.py ask send*": "ask",
      "python3 kb/tools/kb.py step enough*": "ask",
      "python kb/tools/kb.py step enough*": "ask",
      "python3 kb/tools/kb.py hooks*": "ask",
      "python3 kb/tools/kb.py step status*": "ask",
      "python kb/tools/kb.py step status*": "ask",
      "python3 kb/tools/kb.py take*": "ask",
      "python kb/tools/kb.py take*": "ask",
      "python3 kb/tools/kb.py notes take*": "ask",
      "python kb/tools/kb.py notes take*": "ask",
      "python3 kb/tools/kb.py dec new*": "ask",
      "python kb/tools/kb.py dec new*": "ask",
      "python3 kb/tools/kb.py dec status*": "ask",
      "python kb/tools/kb.py dec status*": "ask",
      "python3 kb/tools/kb.py spec set*": "ask",
      "python kb/tools/kb.py spec set*": "ask",
      "python3 kb/tools/kb.py spec accept*": "ask",
      "python kb/tools/kb.py spec accept*": "ask",
      "python3 kb/tools/kb.py spec early*": "ask",
      "python kb/tools/kb.py spec early*": "ask",
      "python3 kb/tools/kb.py package load*": "ask",
      "python kb/tools/kb.py package load*": "ask",
      "python3 kb/tools/kb.py q sort*": "ask",
      "python3 kb/tools/kb.py q close*": "ask",
      "python3 kb/tools/kb.py q out*": "ask",
      "python kb/tools/kb.py q sort*": "ask",
      "python kb/tools/kb.py q close*": "ask",
      "python kb/tools/kb.py q out*": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      "git -c*": "deny",
      "git config*": "deny",
      "git remote add*": "deny",
      "git remote set-url*": "deny",
      "git remote remove*": "deny",
      "git remote rm*": "deny",
      "git update-ref*": "deny",
      "git commit-tree*": "deny",
      "*--no-verify*": "deny",
      "*core.hooksPath*": "deny",
      "*&& git commit*": "deny",
      "*; git commit*": "deny",
      "*&& git push*": "deny",
      "*; git push*": "deny",
      "python3 kb/tools/kb.py models*": "allow"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      ".opencode/*": "deny",
      ".git/*": "deny",
      "kb/rules/*": "deny",
      "kb/tools/*": "deny",
      "kb/materials/*": "ask",
      "kb/journal/views/*": "deny",
      "kb/journal/reports/*": "deny",
      "kb/context/process/_deps.md": "deny"
    },
    "task": {
      "*": "deny",
      "kb-*": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask"
  },
  "default_agent": "kb",
  "agent": {
    "kb": {
      "mode": "primary",
      "description": "Основной агент базы знаний: поиск, запись по «да», вопросы, коммит по «да»",
      "model": "{env:KB_MODEL_MEDIUM}",
      "prompt": "{file:./.opencode/prompts/kb.md}"
    },
    "razbor": {
      "mode": "primary",
      "description": "Разбор шага по критерию глубины — долгий диалог на сильной модели",
      "model": "{env:KB_MODEL_DIALOG}",
      "prompt": "{file:./.opencode/prompts/razbor.md}"
    },
    "kb-vstrecha": {
      "mode": "subagent",
      "description": "Расшифровка встречи → ответы на вопросы, предложения, факты. Черновик, без записи",
      "model": "{env:KB_MODEL_HEAVY}",
      "prompt": "{file:./.opencode/prompts/kb-vstrecha.md}",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "python3 kb/tools/kb.py check*": "allow",
          "python3 kb/tools/kb.py similar*": "allow",
          "python3 kb/tools/kb.py step gaps*": "allow",
          "python3 kb/tools/kb.py whoami*": "allow",
          "python3 kb/tools/kb.py where*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "ls*": "allow"
        },
        "task": "deny",
        "webfetch": "deny"
      }
    },
    "kb-vstrecha-pd": {
      "mode": "subagent",
      "description": "То же для расшифровки с персональными данными — на внутренней модели",
      "model": "{env:KB_MODEL_INTERNAL_THINK}",
      "prompt": "{file:./.opencode/prompts/kb-vstrecha-pd.md}",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "python3 kb/tools/kb.py check*": "allow",
          "python3 kb/tools/kb.py similar*": "allow",
          "python3 kb/tools/kb.py step gaps*": "allow",
          "python3 kb/tools/kb.py whoami*": "allow",
          "python3 kb/tools/kb.py where*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "ls*": "allow"
        },
        "task": "deny",
        "webfetch": "deny"
      }
    },
    "kb-peresecheniya": {
      "mode": "subagent",
      "description": "Похожие вход, выход и сущности у разных шагов: «один это шаг или два?»",
      "model": "{env:KB_MODEL_HEAVY}",
      "prompt": "{file:./.opencode/prompts/kb-peresecheniya.md}",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "python3 kb/tools/kb.py check*": "allow",
          "python3 kb/tools/kb.py similar*": "allow",
          "python3 kb/tools/kb.py step gaps*": "allow",
          "python3 kb/tools/kb.py whoami*": "allow",
          "python3 kb/tools/kb.py where*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "ls*": "allow"
        },
        "task": "deny",
        "webfetch": "deny"
      }
    },
    "kb-sverka": {
      "mode": "subagent",
      "description": "Список «так ли вы работаете» по шагу для сверки с бизнесом",
      "model": "{env:KB_MODEL_MEDIUM}",
      "prompt": "{file:./.opencode/prompts/kb-sverka.md}",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "python3 kb/tools/kb.py check*": "allow",
          "python3 kb/tools/kb.py similar*": "allow",
          "python3 kb/tools/kb.py step gaps*": "allow",
          "python3 kb/tools/kb.py whoami*": "allow",
          "python3 kb/tools/kb.py where*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "ls*": "allow"
        },
        "task": "deny",
        "webfetch": "deny"
      }
    },
    "general": {
      "disable": true
    }
  },
  "command": {
    "gde": {
      "description": "Где я и что дальше",
      "model": "{env:KB_MODEL_LIGHT}",
      "template": "Вызови `python3 kb/tools/kb.py where`. Ответь тремя строками из вывода: «Ты здесь», «Дальше», «Почему». Ничего не добавляй."
    },
    "utro": {
      "description": "Полный утренний отчёт",
      "model": "{env:KB_MODEL_LIGHT}",
      "template": "Вызови `python3 kb/tools/kb.py report morning $ARGUMENTS`. Покажи вывод целиком. Сверху — до 5 строк: что важно сегодня."
    },
    "kommit": {
      "description": "Показать план коммита",
      "model": "{env:KB_MODEL_LIGHT}",
      "template": "Вызови `python3 kb/tools/kb.py commit plan`. Покажи вывод целиком и спроси: «Коммитим?». Без «да» не вызывай commit apply."
    },
    "razbor": {
      "description": "Разбор шага: /razbor PM-XX",
      "agent": "razbor",
      "template": "Начни разбор шага $ARGUMENTS."
    },
    "vstrecha": {
      "description": "Разобрать расшифровку встречи: /vstrecha <файл>",
      "agent": "kb-vstrecha",
      "template": "Разбери расшифровку $ARGUMENTS."
    },
    "peresecheniya": {
      "description": "Найти пересечения шагов",
      "agent": "kb-peresecheniya",
      "template": "Найди пересечения шагов $ARGUMENTS."
    },
    "sverka": {
      "description": "Список для сверки с бизнесом: /sverka PM-XX",
      "agent": "kb-sverka",
      "template": "Подготовь список «так ли вы работаете» по шагу $ARGUMENTS."
    }
  }
}
