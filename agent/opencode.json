{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "python3 kb/tools/kb.py *": "allow",
      "python kb/tools/kb.py *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "grep *": "allow",
      "python3 kb/tools/kb.py commit apply*": "ask",
      "python kb/tools/kb.py commit apply*": "ask",
      "python3 kb/tools/kb.py ask send*": "ask",
      "python kb/tools/kb.py ask send*": "ask",
      "python3 kb/tools/kb.py step enough*": "ask",
      "python kb/tools/kb.py step enough*": "ask",
      "python3 kb/tools/kb.py hooks*": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      "git -c*": "deny",
      "git config*": "deny",
      "git remote add*": "deny",
      "git remote set-url*": "deny",
      "git remote remove*": "deny",
      "git remote rm*": "deny",
      "git update-ref*": "deny",
      "git commit-tree*": "deny",
      "*--no-verify*": "deny",
      "*core.hooksPath*": "deny",
      "*&& git commit*": "deny",
      "*; git commit*": "deny",
      "*&& git push*": "deny",
      "*; git push*": "deny"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      ".opencode/*": "deny",
      ".git/*": "deny",
      "kb/rules/*": "deny",
      "kb/tools/*": "deny",
      "kb/materials/*": "ask",
      "kb/journal/views/*": "deny",
      "kb/journal/reports/*": "deny",
      "kb/context/process/_deps.md": "deny"
    },
    "task": {
      "*": "deny",
      "kb-*": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask"
  }
}
