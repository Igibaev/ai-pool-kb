{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "kb",
  "compaction": { "auto": true, "prune": true },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "python3 tools/kb.py *": "allow",
      "python tools/kb.py *": "allow",
      "py -3 tools/kb.py *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git config user.name": "allow",
      "git remote*": "allow",
      "git branch*": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git pull*": "allow",
      "ls*": "allow",
      "grep *": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "rm *": "ask"
    }
  }
}
